# Required
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/resume-optimizer

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App URL — local dev use localhost; production (Railway):
# NEXT_PUBLIC_APP_URL=https://resumefit.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Upstash Redis for distributed rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quotas & limits
# Admin panel (comma-separated Clerk account emails)
ADMIN_EMAILS=you@example.com

# Credit-based pricing (fallback if DB settings missing)
FREE_CREDITS_PER_MONTH=3
SIGNUP_BONUS_CREDITS=1
PRO_MONTHLY_CREDIT_CAP=50
CREDIT_PACK_SIZE=10

RATE_LIMIT_OPTIMIZE_PER_HOUR=5
# Set to true to enforce optimize rate limits while running npm run dev locally
# RATE_LIMIT_IN_DEV=true
MAX_UPLOAD_BYTES=5242880

# Stripe payments — add these when ready (app works without them; admin can grant Pro manually)
# 1. Create Pro subscription price + one-time credit pack price in Stripe Dashboard
# 2. Webhook: POST https://your-domain.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# 3. Local testing: npm run stripe:listen
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRO_PRICE_ID=price_
STRIPE_CREDIT_PACK_PRICE_ID=price_

# Optional analytics & SEO
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Puppeteer override (Docker sets /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=

# Logging
LOG_LEVEL=info

# Server
PORT=3000
